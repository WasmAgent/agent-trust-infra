{
  "name": "@wasmagent/agent-trust-infra",
  "private": true,
  "version": "0.0.0-research",
  "description": "Public research preview for Agent Trust Infrastructure.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "cli/*"
  ],
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "chain": "bun cli/src/index.ts chain",
    "lint": "biome check packages/ cli/",
    "lint:fix": "biome check --write packages/ cli/",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@wasmagent/protocol": "^0.1.7",
    "turbo": "^2.10.7",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@openagentaudit/passport": "^0.5.2",
    "@wasmagent/aep": "^1.21.1"
  }
}
